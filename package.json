{
  "name": "chunmo-project-manager",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run build:api",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "node --env-file=.env.development.local --import tsx server/index.ts",
    "api:test": "node --env-file=.env.test.local --import tsx server/index.ts",
    "db:development": "node scripts/cloud-db.mjs development && node --import tsx scripts/cloud-provision.ts development",
    "db:test": "node scripts/cloud-db.mjs test && node --import tsx scripts/cloud-provision.ts test",
    "db:migrate": "node --env-file=.env.development.local --import tsx server/migrate.ts",
    "owner:create": "node --env-file=.env.development.local --import tsx scripts/cloud-owner.ts",
    "build:api": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-api/server.mjs",
    "test:api": "node --env-file=.env.test.local --import tsx --test --test-concurrency=1 server/cloud.test.ts server/audit.test.ts server/migration.test.ts",
    "test:cloud:e2e": "playwright test --config playwright.cloud.config.ts",
    "test:all": "npm test && npm run test:api && npm run test:e2e && npm run test:cloud:e2e",
    "verify:native": "node scripts/verify-native.mjs",
    "build:deploy": "tsc -p tsconfig.server.json && esbuild deploy/native/admin.ts deploy/native/ops.ts deploy/native/public.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-deploy --out-extension:.js=.mjs",
    "test:deploy": "node --import tsx --test deploy/native/*.test.ts",
    "test:native-lab": "node --import tsx deploy/native/lab.ts"
  },
  "dependencies": {
    "@uiw/color-convert": "^2.10.3",
    "@uiw/react-color-wheel": "^2.9.2",
    "argon2": "^0.45.1",
    "date-fns": "^4.1.0",
    "express": "^5.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
