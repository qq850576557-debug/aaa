# Documentation only. Do not copy placeholders into a running server.
# npm run db:development / db:test generate ignored .env.<mode>.local files.
# Never commit .env.*.local, passwords, connection URLs or the encryption key.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=4000
DATABASE_URL=postgresql://chunmo_app:REPLACE@127.0.0.1:55432/chunmo_development
PRIVATE_DATABASE_URL=postgresql://chunmo_private:REPLACE@127.0.0.1:55432/chunmo_development
PRIVATE_DATA_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
# Tooling only; do not give migration credentials to the production API process.
MIGRATION_DATABASE_URL=postgresql://chunmo:REPLACE@127.0.0.1:55432/chunmo_development
