page {
  background: #f7f8f4;
  color: #293d34;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 15px;
  box-sizing: border-box;
}
view,
button,
input,
scroll-view {
  box-sizing: border-box;
}
button {
  font-size: 15px;
  line-height: 1.4;
  padding: 13px 18px;
  border-radius: 12px;
  border: 0;
  margin: 0;
  background: #eaf0e9;
  color: #244e42;
  font-weight: 500;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.45;
}
.primary {
  background: #244e42;
  color: #fff;
}
.quiet {
  background: transparent;
}
.error {
  color: #9f4033;
  background: #fff1ec;
  border-radius: 10px;
  padding: 12px 14px;
  line-height: 1.5;
}
.muted {
  color: #617269;
  font-size: 13px;
}
.page {
  padding: 20px;
}
.panel {
  background: #fff;
  border: 1px solid #e3e8e0;
  border-radius: 18px;
  padding: 20px;
}
.field {
  width: 100%;
  height: 50px;
  background: #fff;
  border: 1px solid #e3e8e0;
  padding: 0 14px;
  border-radius: 10px;
  margin-bottom: 12px;
}
.row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.between {
  justify-content: space-between;
}
.title {
  font-size: 22px;
  font-weight: 600;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
  background: #f7f8f4;
  border-top: 1px solid #e3e8e0;
  z-index: 5;
}
.chip {
  display: inline-block;
  background: #edf2ec;
  border-radius: 8px;
  padding: 5px 9px;
  font-size: 12px;
  color: #244e42;
}
.permission {
  margin-top: 12px;
}
.spaced {
  margin-top: 16px;
}
