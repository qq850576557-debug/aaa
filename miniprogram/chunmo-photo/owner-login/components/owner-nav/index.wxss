.owner-nav {
  position: fixed;
  z-index: 3;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 10rpx 28rpx calc(10rpx + max(env(safe-area-inset-bottom), 10px));
  border-top: 1px solid #FFFFFFA3;
  background: linear-gradient(#FBF9F7, #F8F5F3);
}
.owner-nav .owner-nav-tab {
  flex: 0 0 178rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  min-height: max(88rpx, 44px);
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 40rpx;
  background: transparent;
  font-size: 21rpx;
  line-height: 1.25;
  color: #626A65;
}
.owner-nav-tab::after { border: 0; }
.owner-nav .selected {
  color: #496D28;
  font-weight: 600;
  background: linear-gradient(125deg, #F3F5EA, #EBEEE1);
  box-shadow: 0 4rpx 12rpx rgba(63, 72, 40, .05);
}
.owner-nav-icon { width: 43rpx; height: 43rpx; }
.owner-nav-tab:not(.selected) .owner-nav-icon { filter: grayscale(1); opacity: .74; }
