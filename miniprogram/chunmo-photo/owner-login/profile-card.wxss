@import './portal.wxss';

page { background: #F8F5F3; }

.portal.profile-page {
  --profile-surface: linear-gradient(150deg, #FFFDFC, #F0F2E8);
  --profile-shadow: 0 9rpx 24rpx rgba(68, 54, 37, .06);
  --profile-radius: 38rpx;
  --portal-ink: #294537;
  display: flex;
  flex-direction: column;
  padding-left: 28rpx;
  padding-right: 28rpx;
  background: #F8F5F3;
}
.profile-wrap {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 23rpx;
}
.profile-card {
  position: relative;
  width: 100%;
  aspect-ratio: 750 / 290;
  border-radius: var(--profile-radius);
  box-shadow: var(--profile-shadow);
}
.profile-card-employee {
  background: var(--profile-surface);
  box-shadow: var(--profile-shadow), inset 0 0 0 1px #FFF;
}
.profile-summary {
  position: relative;
  display: flex;
  align-items: center;
  gap: min(var(--ui-avatar-text-gap, 22px), 36rpx);
  width: 100%;
  height: 100%;
  padding: 8rpx min(var(--ui-info-card-padding, 28px), 42rpx);
}
.portal .profile-avatar-trigger {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
  padding: 0;
  background: transparent;
  line-height: 1.35;
}
.profile-avatar {
  display: grid;
  width: min(var(--ui-avatar-size, 63px), 147rpx);
  aspect-ratio: 1;
  place-items: center;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(145deg, #E8EDDF, #DAE2CE);
  box-shadow: inset 0 0 0 1px #FFF;
}
.profile-avatar-label {
  color: var(--portal-muted);
  font-size: max(10px, 20rpx);
}
.profile-pressed .profile-avatar { background: var(--portal-pressed); }
.profile-avatar-photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-avatar-icon {
  width: 42%;
  height: 42%;
}
.profile-identity {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.profile-name,
.profile-subtitle {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
}
.profile-name {
  font-size: clamp(18px, 45rpx, 26px);
  line-height: 1.18;
  font-weight: 650;
  -webkit-line-clamp: 2;
}
.profile-detail {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1px solid #DDE1D5;
  color: var(--portal-muted);
  font-size: clamp(11px, 25rpx, 14px);
  line-height: 1.37;
}
.profile-subtitle { min-width: 0; -webkit-line-clamp: 3; }
.profile-residence-icon {
  flex: none;
  width: 1.2em;
  height: 1.2em;
}
.profile-settings {
  overflow: hidden;
  margin: 0;
  border: 1px solid #FFF;
  border-radius: var(--profile-radius);
  background: #FFFEFC;
  box-shadow: var(--profile-shadow);
}
.profile-settings .portal-row {
  margin: 0;
  padding: 10px 16px;
  border-radius: 0;
  background: transparent;
  font-size: 14px;
}
.profile-settings > button + button {
  border-top: 1px solid var(--portal-line);
}
.profile-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: auto;
  padding-top: var(--ui-footer-top-gap, 24px);
}
.profile-footer-logo {
  width: calc(var(--ui-footer-font-size, 12px) + 6px);
  height: calc(var(--ui-footer-font-size, 12px) + 7px);
}
.profile-footer-wordmark {
  width: var(--ui-footer-wordmark, 73px);
  height: var(--ui-footer-font-size, 12px);
}

.avatar-overlay {
  position: fixed;
  inset: 0;
  z-index: 5;
  display: grid;
  place-items: center;
  padding: 16px;
}
.avatar-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(29, 52, 42, 0.3);
}
.avatar-dialog {
  z-index: 1;
  box-sizing: border-box;
  width: min(100%, 360px);
  max-height: calc(100vh - 32px);
  overflow-y: auto;
  padding: 17px;
  border-radius: 23px;
  background: var(--portal-paper);
}
.avatar-title,
.avatar-hint {
  display: block;
  text-align: center;
}
.avatar-title {
  font-size: 16px;
  font-weight: 600;
}
.avatar-hint {
  margin: 2px 0 12px;
  color: var(--portal-muted);
  font-size: 11px;
}
.avatar-frame {
  width: min(64vw, 38vh, 248px);
  height: min(64vw, 38vh, 248px);
  margin: 0 auto;
  overflow: hidden;
  border-radius: 12px;
  background: var(--portal-wash);
}
.avatar-canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}
.avatar-scale {
  display: flex;
  align-items: center;
  gap: 9px;
  min-height: 38px;
  padding: 0 6px;
  color: var(--portal-muted);
  font-size: 11px;
}
.avatar-scale slider {
  flex: 1;
  margin: 0 10px;
}
.avatar-actions {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 8px;
}
.avatar-actions .small-button {
  min-height: 44px;
}
.portal .avatar-save {
  background: #244e42;
  color: #fff;
}
.portal .avatar-save[disabled] {
  background: var(--portal-wash);
  color: var(--portal-muted);
}

.privacy-copy {
  display: block;
  margin: 8px 0;
  color: var(--portal-muted);
  font-size: 13px;
}
.portal .privacy-policy-button {
  min-height: 44px;
  padding: 0;
  margin: 0 0 6px;
  background: transparent;
  text-align: left;
  font-size: 12px;
}
