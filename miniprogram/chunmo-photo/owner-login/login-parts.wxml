<template name="brand">
  <view class="brand-lockup">
    <image
      class="brand-logo"
      src="/owner-login/assets/brand-logo.png"
      mode="aspectFit"
      aria-hidden="{{true}}"
    />
    <image
      class="brand-name"
      src="/owner-login/assets/brand-name.png"
      mode="aspectFit"
      aria-label="春茉空间设计"
    />
  </view>
</template>

<template name="sign-in">
  <view class="sign-in-label">
    <image
      wx:if="{{quick}}"
      class="quick-icon"
      src="/owner-login/assets/chat.png"
      mode="aspectFit"
      aria-hidden="{{true}}"
    />
    <text>{{quick ? '微信快捷登录' : '登录'}}</text>
  </view>
</template>
