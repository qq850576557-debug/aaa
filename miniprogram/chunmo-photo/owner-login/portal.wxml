<template name="navigation">
  <view class="portal-nav">
    <button class="portal-back" aria-label="返回" bindtap="back">
      <view class="portal-arrow portal-arrow-back" aria-hidden="{{true}}"></view>
    </button>
    <text>{{title}}</text>
    <view class="nav-space"></view>
  </view>
</template>

<template name="load-state">
  <view class="portal-card load-state" wx:if="{{error}}" aria-role="alert">
    <text class="state-title">暂时无法打开</text>
    <text>{{error}}</text>
    <button class="small-button" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{loading}}" class="portal-card load-state" aria-role="status">
    <text>正在读取采购信息…</text>
  </view>
</template>

<template name="purchase-row">
  <button
    class="purchase-row"
    data-id="{{item.id}}"
    bindtap="openPurchase"
    hover-class="row-pressed"
  >
    <view class="purchase-row-detail">
      <text class="purchase-row-title">{{item.title}}</text>
      <text wx:if="{{item.description}}" class="purchase-row-description"
        >{{item.description}}</text
      >
      <view class="purchase-row-meta">
        <text class="purchase-date">{{item.due}}</text>
        <text class="purchase-status" wx:if="{{showPurchaseStatus}}">{{item.statusLabel}}</text>
        <text class="due-tag" wx:if="{{item.overdue}}">已逾期</text>
      </view>
    </view>
    <view class="portal-arrow" aria-hidden="{{true}}"></view>
  </button>
</template>
