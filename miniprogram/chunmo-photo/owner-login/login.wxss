@import './font.wxss';

page {
  background: #fff;
}
.owner-login {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: clamp(24px, 8.8vw, 44px);
  padding-right: clamp(24px, 8.8vw, 44px);
  color: #244e42;
  background: #fff;
  font-family:
    'Chunmo Login UI',
    -apple-system,
    'PingFang SC',
    'Microsoft YaHei',
    sans-serif;
}
.owner-login button,
.owner-login input {
  font-family: inherit;
}
.owner-content {
  width: 100%;
  max-width: 276px;
}
.brand-lockup {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
}
.brand-logo {
  width: 43px;
  height: 46px;
  flex-shrink: 0;
}
.brand-name {
  display: block;
  width: 104px;
  height: 17px;
}
.sign-in-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 44px;
  min-height: 44px;
  padding: 3px 0;
  border: none;
  color: #203f33;
  background: transparent;
  box-shadow: none;
}
.sign-in-button::after {
  border: 0;
}
.sign-in-label {
  box-sizing: border-box;
  width: 100%;
  height: 38px;
  border-radius: 999px;
  background: #e5efe2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.05em;
  transition:
    transform 200ms cubic-bezier(0.25, 0.75, 0.3, 1),
    background-color 180ms ease;
}
.sign-in-pressed .sign-in-label {
  background: #d5e5d1;
  transform: scale(0.984, 0.95);
}
.quick-icon {
  width: 17px;
  height: 17px;
}
.feedback {
  margin: 12px 0 0;
  text-align: center;
  color: #496757;
  font-size: 11px;
  line-height: 1.45;
}
.owner-link {
  border: 0;
  background: transparent;
}
.owner-link-down {
  opacity: 0.72;
}
.arrow-mark {
  box-sizing: border-box;
  display: inline-block;
  width: 7px;
  height: 7px;
  border-right: 1.5px solid currentColor;
  border-top: 1.5px solid currentColor;
  transform: rotate(45deg);
}
@media (prefers-reduced-motion: reduce) {
  .sign-in-label {
    transition: none;
  }
}
