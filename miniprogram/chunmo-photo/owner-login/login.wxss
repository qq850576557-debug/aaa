@import './font.wxss';

page {
  background: #fff;
}
.owner-login {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: clamp(24px, 8.8vw, 44px);
  padding-right: clamp(24px, 8.8vw, 44px);
  color: #244e42;
  background: #fff;
  font-family:
    'Chunmo Login UI',
    -apple-system,
    'PingFang SC',
    'Microsoft YaHei',
    sans-serif;
}
.owner-login button,
.owner-login input {
  font-family: inherit;
}
.owner-content {
  width: 100%;
  max-width: 380px;
}
.brand-lockup {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.brand-logo {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
}
.brand-lettering {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}
.brand-name {
  display: block;
  width: 127px;
  height: 20px;
}
.brand-initials {
  font-size: 9px;
  letter-spacing: 0.37em;
  line-height: 1;
  padding-left: 0.37em;
}
.plush-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  isolation: isolate;
  width: 100%;
  height: 57px;
  min-height: 48px;
  padding: 0 16px;
  overflow: hidden;
  border: none;
  border-radius: 999px;
  color: #203f33;
  background: #f6f3eb;
  box-shadow: none;
  transition: transform 220ms cubic-bezier(0.25, 0.75, 0.3, 1);
}
.plush-button::after {
  border: 0;
}
.plush-fabric {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.88;
  transition:
    opacity 180ms ease,
    transform 220ms ease;
}
.plush-label {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding-left: 0.15em;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-shadow:
    0 1px 1px #263a2c35,
    0 -1px 1px #fffcf4af;
  transition: transform 200ms ease;
}
.plush-pressed {
  transform: scale(0.984, 0.948);
}
.plush-pressed .plush-fabric {
  opacity: 1;
  transform: scale(1.06);
}
.plush-pressed .plush-label {
  transform: translateY(1px);
}
.quick-icon {
  width: 26px;
  height: 26px;
}
.quick-divider {
  width: 1px;
  height: 17px;
  background: #64766a;
}
.feedback {
  margin: 12px 0 0;
  text-align: center;
  color: #496757;
  font-size: 13px;
  line-height: 1.45;
}
.owner-link {
  border: 0;
  background: transparent;
}
.owner-link-down {
  opacity: 0.72;
}
.arrow-mark {
  box-sizing: border-box;
  display: inline-block;
  width: 7px;
  height: 7px;
  border-right: 1.5px solid currentColor;
  border-top: 1.5px solid currentColor;
  transform: rotate(45deg);
}
@media (prefers-reduced-motion: reduce) {
  .plush-button,
  .plush-fabric,
  .plush-label {
    transition: none;
  }
}
