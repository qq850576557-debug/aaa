@import '../../login.wxss';

.staff-login {
  padding-bottom: 32px;
  padding-bottom: calc(32px + env(safe-area-inset-bottom));
}
.staff-nav {
  height: 48px;
}
.back-button {
  width: 44px;
  height: 44px;
  padding: 0;
  margin-left: -12px;
  display: grid;
  place-items: center;
}
.back-button .arrow-mark {
  width: 11px;
  height: 11px;
  transform: rotate(-135deg);
}
.staff-brand {
  margin-top: clamp(34px, calc(22vh - 95px), 114px);
}
.staff-form {
  min-width: 0;
  max-width: 252px;
  margin-top: clamp(32px, calc(13vh - 35px), 74px);
}
.staff-field {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 37px;
  padding: 0 10px 0 13px;
  border: 1px solid #e5e9e5;
  border-radius: 13px;
  background: #fff;
  transition: border-color 200ms ease;
}
.staff-field:focus-within {
  border-color: #9bb3a4;
}
.staff-field + .staff-field {
  margin-top: 12px;
}
.field-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}
.staff-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 35px;
  color: #244e42;
  font-size: 12px;
}
.staff-placeholder {
  color: #818983;
}
.password-toggle {
  width: 36px;
  height: 37px;
  flex: 0 0 36px;
  display: grid;
  place-items: center;
  padding: 0;
  margin: 0 -7px 0 0;
}
.staff-submit {
  margin-top: clamp(22px, calc(8vh - 14px), 50px);
}
.staff-keyboard .staff-brand {
  margin-top: 7px;
}
.staff-keyboard .staff-form {
  margin-top: 22px;
}
.staff-keyboard .staff-submit {
  margin-top: 20px;
}
