@import '../../login.wxss';

.welcome-login {
  padding-bottom: 50px;
  padding-bottom: calc(39px + env(safe-area-inset-bottom));
}
.welcome-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: clamp(69px, calc(26.6vh - 51px), 194px);
}
.brand-slogan {
  margin-top: 12px;
  color: #415c4a;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.14em;
}
.welcome-actions {
  margin-top: clamp(60px, calc(27vh - 51px), 177px);
}
.employee-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  margin: 7px auto 0;
  padding: 6px 15px;
  color: #58625b;
  font-size: 12px;
  letter-spacing: 0.06em;
}
.owner-consent {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-top: auto;
  padding-top: 10px;
  font-size: 10px;
  line-height: 1.6;
  color: #626763;
}
.consent-button {
  display: grid;
  flex: 0 0 33px;
  width: 33px;
  height: 42px;
  padding: 0;
  margin: 0;
  place-items: center;
}
.consent-dot {
  box-sizing: border-box;
  position: relative;
  width: 14px;
  height: 14px;
  border: 1px solid #7a867d;
  border-radius: 50%;
}
.consented .consent-dot {
  border-color: #244e42;
  background: #244e42;
}
.consented .consent-dot::after {
  content: '';
  position: absolute;
  width: 6px;
  height: 3px;
  top: 3px;
  left: 2.5px;
  border-bottom: 1.5px solid white;
  border-left: 1.5px solid white;
  transform: rotate(-45deg);
}
.consent-copy {
  min-width: 0;
}
.policy-link {
  color: #2d4539;
  white-space: nowrap;
}
