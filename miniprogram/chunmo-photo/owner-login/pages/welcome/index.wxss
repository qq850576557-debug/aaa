@import '../../login.wxss';

.welcome-login {
  padding-bottom: 50px;
  padding-bottom: calc(39px + env(safe-area-inset-bottom));
}
.welcome-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: clamp(69px, calc(26.6vh - 51px), 194px);
}
.brand-slogan {
  width: 148px;
  height: 19px;
  margin-top: clamp(28px, calc(8.4vh - 22px), 50px);
}
.brand-rule {
  width: 24px;
  height: 1px;
  margin-top: clamp(20px, calc(5vh - 12px), 34px);
  background: #7c8b81;
}
.welcome-actions {
  margin-top: clamp(47px, calc(29vh - 72px), 177px);
}
.employee-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 44px;
  margin: 16px auto 0;
  padding: 7px 18px;
  color: #58625b;
  font-size: 14px;
  letter-spacing: 0.06em;
}
.owner-consent {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-top: auto;
  padding-top: 12px;
  font-size: 12px;
  line-height: 1.6;
  color: #626763;
}
.consent-button {
  display: grid;
  flex: 0 0 33px;
  width: 33px;
  height: 42px;
  padding: 0;
  margin: 0;
  place-items: center;
}
.consent-dot {
  box-sizing: border-box;
  position: relative;
  width: 16px;
  height: 16px;
  border: 1px solid #7a867d;
  border-radius: 50%;
}
.consented .consent-dot {
  border-color: #244e42;
  background: #244e42;
}
.consented .consent-dot::after {
  content: '';
  position: absolute;
  width: 7px;
  height: 4px;
  top: 4px;
  left: 3px;
  border-bottom: 1.5px solid white;
  border-left: 1.5px solid white;
  transform: rotate(-45deg);
}
.consent-copy {
  min-width: 0;
}
.policy-link {
  color: #2d4539;
  white-space: nowrap;
}
