@import '../../login.wxss';

.owner-privacy-screen {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(30, 46, 36, 0.2);
}
.owner-privacy-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 280px;
  padding: 20px;
  border-radius: 16px;
  background: #fff;
  color: #244e42;
  font-size: 14px;
}
.owner-privacy-actions {
  display: flex;
  justify-content: space-between;
}
@import '../../ui-tuning.wxss';

.welcome-login {
  padding-bottom: 50px;
  padding-bottom: calc(39px + env(safe-area-inset-bottom));
}
.welcome-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: clamp(16px, calc(var(--ui-logo-top) + 26.6vh - 224.5px), 245px);
}
.brand-slogan {
  margin-top: var(--ui-brand-to-slogan-gap);
  color: #415c4a;
  font-size: var(--ui-slogan-font-size);
  font-weight: 400;
  letter-spacing: var(--ui-slogan-letter-spacing);
  white-space: pre-wrap;
  text-align: center;
}
.welcome-actions {
  margin-top: clamp(12px, calc(var(--ui-login-button-top) + 27vh - 227.9px), 235px);
}
.employee-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  margin: 7px auto 0;
  padding: 6px 15px;
  color: #58625b;
  font-size: 12px;
  letter-spacing: 0.06em;
}
.owner-consent {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-top: auto;
  padding-top: 10px;
  font-size: 10px;
  line-height: 1.6;
  color: #626763;
}
.consent-button {
  display: grid;
  flex: 0 0 33px;
  width: 33px;
  height: 42px;
  padding: 0;
  margin: 0;
  place-items: center;
}
.consent-dot {
  box-sizing: border-box;
  position: relative;
  width: 14px;
  height: 14px;
  border: 1px solid #7a867d;
  border-radius: 50%;
}
.consented .consent-dot {
  border-color: #244e42;
  background: #244e42;
}
.consented .consent-dot::after {
  content: '';
  position: absolute;
  width: 6px;
  height: 3px;
  top: 3px;
  left: 2.5px;
  border-bottom: 1.5px solid white;
  border-left: 1.5px solid white;
  transform: rotate(-45deg);
}
.consent-copy {
  min-width: 0;
}
.policy-link {
  color: #2d4539;
  white-space: nowrap;
}

.welcome-brand .brand-lockup {
  gap: var(--ui-logo-to-brand-gap);
}
.welcome-brand .brand-logo {
  width: var(--ui-logo-width);
  height: var(--ui-logo-height);
}
.welcome-brand .brand-name {
  width: var(--ui-brand-width);
  height: var(--ui-brand-font-size);
}

.welcome-feedback {
  position: relative;
}
.binding-screen {
  z-index: 9;
}
.binding-panel {
  box-sizing: border-box;
  width: 100%;
  max-width: 320px;
}
.binding-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 17px;
  font-weight: 600;
}
.binding-title .owner-link {
  padding: 0 8px;
  margin: 0;
  font-size: 22px;
}
.binding-panel label {
  color: #56675d;
  font-size: 13px;
}
.binding-panel input {
  min-height: 36px;
  margin-top: 4px;
  padding: 0 10px;
  border: 1px solid #e2e9e2;
  border-radius: 10px;
  background: #f7f9f6;
  color: #23473b;
}
.binding-panel .sign-in-button {
  width: 100%;
  color: #244e42;
}
