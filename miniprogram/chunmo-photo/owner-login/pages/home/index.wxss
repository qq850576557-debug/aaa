@import '../../portal.wxss';
@import '../../ui-tuning.wxss';

page { background: #F8F5F3; }

.owner-home {
  --home-background: #F8F5F3;
  --home-ink: #294537;
  --home-muted: #78827A;
  --home-sage: #F0F2E8;
  --home-warning: #A65A31;
  --home-gutter: 28rpx;
  --home-radius: 45rpx;
  --home-mascot-lip: 96.589rpx;
  --home-shadow: 0 11rpx 27rpx rgba(68, 54, 37, .07), inset 0 0 0 2rpx rgba(255, 255, 255, .78);
  padding: max(calc(195rpx + var(--ui-header-top) - 56px), calc(var(--home-status) + var(--home-mascot-lip) + 4px))
    var(--home-gutter) calc(max(124rpx, 61px) + max(env(safe-area-inset-bottom), 10px));
  color: var(--home-ink);
  background: var(--home-background);
  font-variant-numeric: tabular-nums;
}
.home-scrolled::before {
  content: '';
  position: fixed;
  inset: 0 0 auto;
  z-index: 2;
  height: calc(var(--home-status) + 44px);
  background: var(--home-background);
  pointer-events: none;
}

.home-residence { position: relative; margin-bottom: calc(60rpx + var(--ui-title-bottom-gap) - 18px); }
.home-plaque {
  min-height: 230rpx;
  padding: 34rpx 39rpx 37rpx;
  border-radius: var(--home-radius);
  background: linear-gradient(150deg, #FFFEFC, #F0F1E8);
  box-shadow: var(--home-shadow);
}
.home-mascot {
  position: absolute;
  top: calc(-1 * var(--home-mascot-lip));
  left: min(63.832853%, calc(var(--home-capsule-left, 100vw) - var(--home-gutter) - 52rpx - 4px));
  width: 104rpx;
  height: 118.106rpx;
  transform: translateX(-50%);
  pointer-events: none;
}
.home-eyebrow, .home-title { display: block; }
.home-eyebrow { color: #697C62; font-size: 22rpx; letter-spacing: 6rpx; line-height: 1.45; }
.home-title { margin: 11rpx 0 18rpx; font-size: 41rpx; font-weight: 650; line-height: 1.23; overflow-wrap: anywhere; }
.home-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.owner-home .home-phase {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 42rpx;
  padding: 3rpx 16rpx;
  border-radius: 999px;
  background: #E6ECD9;
  color: #496D28;
  font-size: 23rpx;
  font-weight: 600;
}
text.home-phase::before { content: ''; width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; }
.owner-home .home-switch { background: #FFFEFC; color: var(--home-ink); font-size: 21rpx; min-height: 30px; }

.owner-home .home-pending, .owner-home .home-stat, .home-schedule {
  background: linear-gradient(150deg, white, var(--home-sage));
  box-shadow: var(--home-shadow);
}
.owner-home .home-pending, .owner-home .home-stat, .owner-home .home-row {
  width: 100%;
  display: flex;
  align-items: center;
  text-align: left;
}
.owner-home .home-pending {
  min-height: calc(145rpx + var(--ui-primary-card-height) - 64px);
  gap: 28rpx;
  padding: 17rpx 30rpx;
  border-radius: 40rpx;
}
.home-icon-tile {
  display: grid;
  flex: none;
  place-items: center;
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  background: linear-gradient(150deg, white, #F2F3E9);
  box-shadow: 0 5rpx 12rpx rgba(69, 62, 37, .06);
}
.home-icon { width: 62rpx; height: 62rpx; }
.home-chevron { flex: none; width: 28rpx; height: 28rpx; opacity: .78; }
.home-counts {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: baseline;
  min-width: 0;
  column-gap: 14rpx;
  padding-left: 28rpx;
  border-left: 1px solid #DDE1D5;
  line-height: 1.05;
}
.home-pending-title, .home-pending-count, .home-total,
.home-stat-title, .home-stat-count { white-space: nowrap; }
.home-pending-title { font-size: 36rpx; font-weight: 650; }
.home-pending-count { font-size: 86rpx; font-weight: 650; }
.home-total { color: var(--home-muted); font-size: 21rpx; }

.home-quick {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(26rpx + var(--ui-secondary-card-gap) - 12px);
  margin-top: 26rpx;
}
.owner-home .home-stat { min-height: 120rpx; gap: 10rpx; padding: 14rpx 15rpx 14rpx 23rpx; border-radius: 36rpx; }
.home-stat .home-icon-tile { width: 57rpx; height: 57rpx; border-radius: 19rpx; }
.home-stat .home-icon { width: 43rpx; height: 43rpx; }
.home-stat .home-chevron { width: 22rpx; height: 22rpx; }
.home-stat-title { padding-left: 12rpx; border-left: 1px solid #E3E5DD; font-size: 25rpx; font-weight: 650; }
.home-stat-count { margin-left: auto; font-size: 47rpx; line-height: 1; font-weight: 650; }
.owner-home .home-stat-warning { background: linear-gradient(150deg, white, #F6ECE2); }
.home-stat-warning .home-stat-count { color: var(--home-warning); }

.home-schedule-title {
  display: flex;
  align-items: center;
  gap: 17rpx;
  margin: calc(48rpx + var(--ui-section-top-gap) - 22px) 8rpx 24rpx;
  font-size: 32rpx;
  font-weight: 650;
}
.home-schedule-title::before { content: ''; width: 7rpx; height: 34rpx; border-radius: 5rpx; background: #527638; }
.home-schedule { padding: 0 32rpx 0 40rpx; border-radius: 39rpx; background: linear-gradient(150deg, white, #FBFAF8); }
.owner-home .home-row {
  min-height: 115rpx;
  gap: 14rpx;
  padding: 12rpx 0;
  border-radius: 0;
  background: transparent;
}
.home-row + .home-row { border-top: 1px solid #EEEAE6; }
.home-row-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 2rpx; }
.home-row-name { font-size: 27rpx; line-height: 1.32; font-weight: 650; overflow-wrap: anywhere; }
.home-description { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #646B64; font-size: 22rpx; }
.home-row-meta { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.home-date { padding: 5rpx 14rpx; border-radius: 999px; background: var(--home-sage); font-size: 21rpx; line-height: 1.3; }
.home-late { color: var(--home-warning); font-size: 18rpx; line-height: 1.25; }
.home-empty { min-height: 340rpx; padding: 34rpx 0; color: var(--home-muted); font-size: 24rpx; }
.owner-home .home-pressed { background: #E8EDDF; }

@media (max-width: 335px) {
  .home-stat-count { font-size: 40rpx; }
  .owner-home .home-stat { gap: 7rpx; padding-right: 12rpx; }
}

.owner-pane { position: absolute; inset: 0; width: 100%; height: 100%; }
.owner-pane-inactive { visibility: hidden; pointer-events: none; }
