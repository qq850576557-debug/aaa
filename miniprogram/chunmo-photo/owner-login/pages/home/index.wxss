@import '../../portal.wxss';
@import '../../ui-tuning.wxss';

.residence-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: var(--ui-title-bottom-gap);
}
.residence-heading {
  min-width: 0;
  padding-top: 3px;
}
.residence-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 5px;
  min-height: 30px;
}
.phase-label {
  color: var(--portal-muted);
  font-size: 11px;
}
.portal .profile-button {
  display: grid;
  place-items: center;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  margin-left: auto;
  padding: 0;
  border-radius: 50%;
  background: var(--portal-paper);
}
.profile-button-icon {
  width: 18px;
  height: 18px;
}
.portal .residence-switch {
  min-height: 30px;
  padding: 4px 10px;
  font-size: 11px;
}
.portal .pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  min-height: var(--ui-primary-card-height);
  padding: 13px 16px;
  border-radius: 21px;
  background: var(--portal-wash);
  text-align: left;
}
.portal .pending-card.pending-pressed {
  background: var(--portal-pressed);
}
.pending-quantity {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 7px;
  font-variant-numeric: tabular-nums;
}
.pending-title {
  font-size: 14px;
  font-weight: 500;
}
.pending-number {
  font-size: 31px;
  font-weight: 600;
  line-height: 1.15;
}
.pending-total {
  color: var(--portal-muted);
  font-size: 12px;
}
.pending-arrow {
  display: grid;
  flex: 0 0 32px;
  width: 32px;
  height: 32px;
  place-items: center;
  border-radius: 50%;
  background: #f3f7ee;
}
.quick-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--ui-secondary-card-gap);
  margin-top: 10px;
}
.quick-cards .portal-row {
  margin: 0;
  align-self: stretch;
  min-height: 70px;
}
.quick-count {
  display: block;
  margin-top: 4px;
  color: var(--portal-muted);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
}
.overdue-count {
  color: #845540;
}
.portal .portal-section-title {
  margin-top: var(--ui-section-top-gap);
}
