<import src="../../ui-tuning.wxml" />
<import src="../../portal.wxml" />
<view
  wx:if="{{ready}}"
  class="portal owner-tab-page"
  style="padding-top: calc({{statusTop}}px + var(--ui-header-top)); {{uiStyle}}"
>
  <view class="portal-wrap">
    <view class="residence-top">
      <view wx:if="{{project}}" class="residence-heading">
        <text class="portal-heading">{{project.title}}</text>
        <view class="residence-meta">
          <text class="phase-label">{{project.phase}}</text>
          <button
            wx:if="{{canSwitch}}"
            class="small-button residence-switch"
            bindtap="switchResidence"
            hover-class="row-pressed"
          >
            切换住宅
          </button>
        </view>
      </view>
      <button class="profile-button" aria-label="个人中心" bindtap="profile">
        <image
          class="profile-button-icon"
          src="/owner-login/assets/account.png"
          mode="aspectFit"
          aria-hidden="{{true}}"
        />
      </button>
    </view>
    <template is="load-state" data="{{error: error, loading: loading}}" />
    <block wx:if="{{project}}">
      <button class="pending-card" bindtap="pending" hover-class="pending-pressed">
        <view class="pending-quantity">
          <text class="pending-title">未采购</text>
          <text class="pending-number">{{pendingCount}}</text>
          <text class="pending-total">/ 共 {{totalCount}} 项</text>
        </view>
        <view class="pending-arrow"><view class="portal-arrow" aria-hidden="{{true}}"></view></view>
      </button>
      <view class="quick-cards">
        <button class="portal-row overdue-card" bindtap="overdue" hover-class="row-pressed">
          <view
            ><text>已逾期</text
            ><text class="quick-count {{overdueCount ? 'overdue-count' : ''}}"
              >{{overdueCount}} 项</text
            ></view
          >
          <view class="portal-arrow" aria-hidden="{{true}}"></view>
        </button>
        <button class="portal-row bought-card" bindtap="bought" hover-class="row-pressed">
          <view><text>已下单</text><text class="quick-count">{{boughtCount}} 项</text></view>
          <view class="portal-arrow" aria-hidden="{{true}}"></view>
        </button>
      </view>
      <text class="portal-section-title">近期采购安排</text>
      <block wx:for="{{recent}}" wx:key="id"
        ><template is="purchase-row" data="{{item: item}}"
      /></block>
      <view wx:if="{{!recent.length}}" class="portal-card empty-state">近期暂无采购安排</view>
    </block>
  </view>
  <owner-nav wx:if="{{project}}" active="home" />
  <template wx:if="{{uiDev}}" is="ui-tuning" data="{{fields: uiFields, open: uiOpen}}" />
</view>
