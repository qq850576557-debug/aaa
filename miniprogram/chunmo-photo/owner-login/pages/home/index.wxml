<import src="../../ui-tuning.wxml" />
<import src="../../portal.wxml" />

<template name="home-icon">
  <image class="{{iconClass}}" src="/owner-login/assets/home-v1/{{icon}}.svg" mode="aspectFit" aria-hidden="{{true}}" />
</template>

<view wx:if="{{ready}}" class="portal owner-home {{scrolled ? 'home-scrolled' : ''}}" style="--home-status: {{statusTop}}px; {{capsuleStyle}} {{uiStyle}}">
  <view class="portal-wrap">
    <template is="load-state" data="{{error: error, loading: loading}}" />
    <block wx:if="{{project}}">
      <view class="home-residence">
        <view class="home-plaque">
          <text class="home-eyebrow">MY HOME</text>
          <text class="home-title">{{project.title}}</text>
          <view class="home-meta">
            <text wx:if="{{project.phase}}" class="home-phase">{{project.phase}}</text>
            <button wx:if="{{canSwitch}}" class="home-phase home-switch" bindtap="switchResidence" hover-class="home-pressed">
              切换住宅
            </button>
          </view>
        </view>
        <image class="home-mascot" src="/owner-login/assets/home-v1/xiaokui-peek.png" mode="aspectFit" aria-hidden="{{true}}" />
      </view>

      <button class="home-pending" bindtap="pending" hover-class="home-pressed">
        <view class="home-icon-tile">
          <template is="home-icon" data="{{icon: 'cart', iconClass: 'home-icon'}}" />
        </view>
        <view class="home-counts">
          <text class="home-pending-title">待采购</text>
          <text class="home-pending-count">{{pendingCount}}</text>
          <text class="home-total">/ 共{{totalCount}}项</text>
        </view>
        <template is="home-icon" data="{{icon: 'chevron', iconClass: 'home-chevron'}}" />
      </button>

      <view class="home-quick">
        <button class="home-stat {{overdueCount ? 'home-stat-warning' : ''}}" bindtap="overdue" hover-class="home-pressed">
          <view class="home-icon-tile">
            <template is="home-icon" data="{{icon: 'overdue', iconClass: 'home-icon'}}" />
          </view>
          <text class="home-stat-title">已逾期</text>
          <text class="home-stat-count">{{overdueCount}}</text>
          <template is="home-icon" data="{{icon: 'chevron', iconClass: 'home-chevron'}}" />
        </button>
        <button class="home-stat" bindtap="bought" hover-class="home-pressed">
          <view class="home-icon-tile">
            <template is="home-icon" data="{{icon: 'ordered', iconClass: 'home-icon'}}" />
          </view>
          <text class="home-stat-title">已下单</text>
          <text class="home-stat-count">{{boughtCount}}</text>
          <template is="home-icon" data="{{icon: 'chevron', iconClass: 'home-chevron'}}" />
        </button>
      </view>

      <text class="home-schedule-title">近期采购安排</text>
      <view class="home-schedule">
        <button wx:for="{{recent}}" wx:key="id" class="home-row" data-id="{{item.id}}" bindtap="openPurchase" hover-class="home-pressed">
          <view class="home-row-copy">
            <text class="home-row-name">{{item.title}}</text>
            <text wx:if="{{item.description}}" class="home-description">{{item.description}}</text>
          </view>
          <view wx:if="{{item.homeDate || item.overdue}}" class="home-row-meta">
            <text wx:if="{{item.homeDate}}" class="home-date" aria-label="{{item.due}}">{{item.homeDate}}</text>
            <text wx:if="{{item.overdue}}" class="home-late">已逾期</text>
          </view>
          <template is="home-icon" data="{{icon: 'chevron', iconClass: 'home-chevron'}}" />
        </button>
        <view wx:if="{{!recent.length}}" class="home-empty">近期暂无采购安排</view>
      </view>
    </block>
  </view>
  <owner-nav active="home" />
  <template wx:if="{{uiDev}}" is="ui-tuning" data="{{fields: uiFields, open: uiOpen}}" />
</view>
