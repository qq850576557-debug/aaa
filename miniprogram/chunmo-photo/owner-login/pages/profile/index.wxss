@import '../../portal.wxss';
@import '../../ui-tuning.wxss';

.profile-page,
.profile-wrap {
  display: flex;
  flex-direction: column;
}
.profile-wrap {
  flex: 1;
}
.profile-summary {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--ui-avatar-text-gap);
  margin-top: var(--ui-info-card-top);
  padding: var(--ui-info-card-padding);
}
.portal .profile-avatar-trigger {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 0;
  background: transparent;
  line-height: 1.4;
}
.profile-avatar {
  display: grid;
  width: var(--ui-avatar-size);
  height: var(--ui-avatar-size);
  place-items: center;
  border-radius: 50%;
  background: var(--portal-wash);
}
.profile-avatar-label {
  color: var(--portal-muted);
  font-size: 11px;
}
.profile-pressed .profile-avatar {
  background: var(--portal-pressed);
}
.profile-avatar-photo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-avatar-icon {
  width: 24px;
  height: 24px;
}
.profile-identity {
  min-width: 0;
  overflow-wrap: anywhere;
}
.profile-name {
  display: block;
  margin-bottom: 2px;
  font-size: 20px;
  font-weight: 600;
}
.profile-identity .portal-muted,
.profile-residence {
  display: block;
  color: var(--portal-muted);
  font-size: 11px;
}
.profile-residence {
  margin-top: 5px;
}
.profile-settings {
  overflow: hidden;
  margin-top: 2px;
}
.profile-settings .portal-row {
  margin: 0;
  padding: 10px 16px;
  border-radius: 0;
}
.profile-settings > button + button,
.profile-settings > button + .profile-projects,
.profile-projects + button {
  border-top: 1px solid var(--portal-line);
}
.profile-projects {
  padding: 4px 8px;
  background: #f8faf7;
}
.profile-projects .residence-option {
  padding-left: 12px;
  border-radius: 12px;
  background: transparent;
  font-size: 12px;
}
.residence-option-label {
  min-width: 0;
  overflow-wrap: anywhere;
}
.profile-projects .active-residence {
  background: var(--portal-wash);
}
.current-tag {
  flex-shrink: 0;
  color: var(--portal-muted);
  font-size: 11px;
}
.switch-open {
  transform: rotate(135deg);
}
.profile-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: auto;
  padding-top: var(--ui-footer-top-gap);
}
.profile-footer-logo {
  width: calc(var(--ui-footer-font-size) + 6px);
  height: calc(var(--ui-footer-font-size) + 7px);
}
.profile-footer-wordmark {
  width: var(--ui-footer-wordmark);
  height: var(--ui-footer-font-size);
}
.avatar-overlay {
  position: fixed;
  inset: 0;
  z-index: 5;
  display: grid;
  place-items: center;
  padding: 16px;
}
.avatar-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(29, 52, 42, 0.3);
}
.avatar-dialog {
  z-index: 1;
  box-sizing: border-box;
  width: min(100%, 360px);
  max-height: calc(100vh - 32px);
  overflow-y: auto;
  padding: 17px;
  border-radius: 23px;
  background: var(--portal-paper);
}
.avatar-title,
.avatar-hint {
  display: block;
  text-align: center;
}
.avatar-title {
  font-size: 16px;
  font-weight: 600;
}
.avatar-hint {
  margin: 2px 0 12px;
  color: var(--portal-muted);
  font-size: 11px;
}
.avatar-frame {
  width: min(64vw, 38vh, 248px);
  height: min(64vw, 38vh, 248px);
  margin: 0 auto;
  overflow: hidden;
  border-radius: 12px;
  background: var(--portal-wash);
}
.avatar-canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}
.avatar-scale {
  display: flex;
  align-items: center;
  gap: 9px;
  min-height: 38px;
  padding: 0 6px;
  color: var(--portal-muted);
  font-size: 11px;
}
.avatar-scale slider {
  flex: 1;
  margin: 0 10px;
}
.avatar-actions {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 8px;
}
.avatar-actions .small-button {
  min-height: 44px;
}
.portal .avatar-save {
  background: #244e42;
  color: #fff;
}
.portal .avatar-save[disabled] {
  background: var(--portal-wash);
  color: var(--portal-muted);
}

.privacy-copy {
  display: block;
  margin: 8px 0;
  color: var(--portal-muted);
  font-size: 13px;
}
.portal .privacy-policy-button {
  min-height: 44px;
  padding: 0;
  margin: 0 0 6px;
  background: transparent;
  text-align: left;
  font-size: 12px;
}

.profile-badge {
  position: absolute;
  top: 12px;
  right: 14px;
  padding: 2px 7px;
  border: 1px solid #d5c4a0;
  border-radius: 7px;
  background: linear-gradient(132deg,#f8f0df,#e9dab9 54%,#f8f1e5);
  color: #745b34;
  font-size: 11px;
}

.design-card-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin-bottom: 12px; }
.portal .design-card {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #fff;
  font-size: 13px;
  line-height: 1.35;
}
.design-unpublished { color: #778b7e; font-size: 11px; }
.design-icon {
  width: 22px;
  height: 22px;
  position: relative;
  box-sizing: border-box;
  color: #62816f;
}
.rendering-icon { border: 2px solid currentColor; border-radius: 5px; overflow: hidden; }
.rendering-icon::before {
  content: '';
  position: absolute;
  left: 3px;
  top: 3px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  border: 1px solid currentColor;
}
.rendering-icon::after {
  content: '';
  position: absolute;
  right: 1px;
  bottom: -5px;
  width: 12px;
  height: 12px;
  border: 1.5px solid currentColor;
  transform: rotate(45deg);
}
.panorama-icon {
  border-radius: 4px;
  background:
    linear-gradient(currentColor,currentColor) left top/6px 2px,
    linear-gradient(currentColor,currentColor) left top/2px 6px,
    linear-gradient(currentColor,currentColor) right top/6px 2px,
    linear-gradient(currentColor,currentColor) right top/2px 6px,
    linear-gradient(currentColor,currentColor) left bottom/6px 2px,
    linear-gradient(currentColor,currentColor) left bottom/2px 6px,
    linear-gradient(currentColor,currentColor) right bottom/6px 2px,
    linear-gradient(currentColor,currentColor) right bottom/2px 6px;
  background-repeat: no-repeat;
}
