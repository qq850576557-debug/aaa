@import '../../profile-card.wxss';
@import '../../ui-tuning.wxss';

.owner-tab-page.profile-page {
  padding-top: var(--profile-header-height);
  padding-bottom: calc(max(124rpx, 61px) + max(env(safe-area-inset-bottom), 10px));
}
.owner-tab-page.profile-page::before {
  content: '';
  position: fixed;
  inset: 0 0 auto;
  z-index: 2;
  height: var(--profile-header-height);
  background: #F8F5F3;
  pointer-events: none;
}
.profile-wrap .portal-nav,
.profile-wrap .load-state { margin-bottom: 0; }
.profile-card-svip {
  margin-top: var(--ui-info-card-top);
}
.profile-card-svip .profile-summary { padding-right: 29%; }
.profile-card-svip .profile-avatar {
  background: linear-gradient(140deg, #E8E9D8, #DEDFCC);
  box-shadow: inset 0 0 0 1px #FFFBF4, 0 3rpx 10rpx rgba(143, 110, 63, .15);
}
.profile-frame {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.svip-emblem {
  position: absolute;
  top: 3.1%;
  right: 2.3%;
  width: 23.3%;
  aspect-ratio: 174.72 / 147.26;
  pointer-events: none;
}
.svip-mascot,
.svip-badge { position: absolute; }
/* The lower edge of the supplied PNG sits behind the metal badge. */
.svip-mascot {
  top: 0;
  left: 16.9%;
  width: 71.5%;
  height: 93%;
}
.svip-badge {
  inset: auto 0 0;
  width: 100%;
  height: 35.5%;
  z-index: 1;
}

.profile-settings > button + .profile-projects,
.profile-projects + button {
  border-top: 1px solid var(--portal-line);
}
.profile-projects {
  padding: 4px 8px;
  background: #f8faf7;
}
.profile-projects .residence-option {
  padding-left: 12px;
  border-radius: 12px;
  background: transparent;
  font-size: 12px;
}
.residence-option-label {
  min-width: 0;
  overflow-wrap: anywhere;
}
.profile-projects .active-residence {
  background: var(--portal-wash);
}
.current-tag {
  flex-shrink: 0;
  color: var(--portal-muted);
  font-size: 11px;
}
.switch-open {
  transform: rotate(135deg);
}

.design-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 23rpx;
}
.portal .design-card {
  display: flex;
  aspect-ratio: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1px solid #FFF;
  border-radius: var(--profile-radius);
  background: var(--profile-surface);
  box-shadow: var(--profile-shadow);
  font-size: 14px;
  line-height: 1.35;
}
.design-unpublished { color: var(--portal-muted); font-size: 11px; }
.design-icon {
  width: 24px;
  height: 24px;
  position: relative;
  box-sizing: border-box;
  color: #62816f;
}
.rendering-icon { border: 2px solid currentColor; border-radius: 5px; overflow: hidden; }
.rendering-icon::before {
  content: '';
  position: absolute;
  left: 3px;
  top: 3px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  border: 1px solid currentColor;
}
.rendering-icon::after {
  content: '';
  position: absolute;
  right: 1px;
  bottom: -5px;
  width: 12px;
  height: 12px;
  border: 1.5px solid currentColor;
  transform: rotate(45deg);
}
.panorama-icon {
  border-radius: 4px;
  background:
    linear-gradient(currentColor,currentColor) left top/6px 2px,
    linear-gradient(currentColor,currentColor) left top/2px 6px,
    linear-gradient(currentColor,currentColor) right top/6px 2px,
    linear-gradient(currentColor,currentColor) right top/2px 6px,
    linear-gradient(currentColor,currentColor) left bottom/6px 2px,
    linear-gradient(currentColor,currentColor) left bottom/2px 6px,
    linear-gradient(currentColor,currentColor) right bottom/6px 2px,
    linear-gradient(currentColor,currentColor) right bottom/2px 6px;
  background-repeat: no-repeat;
}
