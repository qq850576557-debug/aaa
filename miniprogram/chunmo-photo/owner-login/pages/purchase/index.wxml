<import src="../../portal.wxml" />
<view wx:if="{{ready}}" class="portal" style="padding-top: {{statusTop + 44}}px">
  <view class="portal-wrap">
    <template is="navigation" data="{{title: '采购详情'}}" />
    <template is="load-state" data="{{error: error, loading: loading}}" />
    <view wx:if="{{unavailable && !error}}" class="portal-card load-state">
      <text class="state-title">当前采购不可查看</text>
      <button class="small-button" bindtap="back">返回采购清单</button>
    </view>
    <block wx:if="{{item}}">
      <view class="portal-card detail-card">
        <view class="detail-badges">
          <text class="detail-status">{{item.statusLabel}}</text>
          <text class="due-tag" wx:if="{{item.overdue}}">已逾期</text>
        </view>
        <text class="portal-heading detail-title">{{item.title}}</text>
        <view class="detail-meta"
          ><text>最迟采购日期</text><text class="detail-value">{{item.due}}</text></view
        >
        <view wx:if="{{item.specification}}" class="detail-meta"
          ><text>规格</text><text class="detail-value">{{item.specification}}</text></view
        >
        <view wx:if="{{item.quantity}}" class="detail-meta"
          ><text>数量</text><text class="detail-value">{{item.quantity}}</text></view
        >
      </view>
      <view wx:if="{{item.description}}" class="portal-card detail-card">
        <text class="detail-card-title">采购说明</text>
        <text class="detail-description">{{item.description}}</text>
      </view>
      <view wx:if="{{item.reference}}" class="portal-card detail-card">
        <text class="detail-card-title">参考资料</text>
        <text selectable="{{true}}" class="detail-description">{{item.reference}}</text>
      </view>
      <view wx:if="{{item.returnReason}}" class="portal-card detail-card">
        <text class="detail-card-title">调整说明</text>
        <text class="detail-description">{{item.returnReason}}</text>
      </view>
      <view wx:if="{{item.state !== 'pending'}}" class="portal-card detail-card">
        <text class="detail-card-title">购买信息</text>
        <view class="detail-meta"
          ><text>品牌</text
          ><text class="detail-value">{{item.feedback.brand || '未填写'}}</text></view
        >
        <view class="detail-meta"
          ><text>型号</text
          ><text class="detail-value">{{item.feedback.model || '未填写'}}</text></view
        >
        <view wx:if="{{item.feedback.link}}" class="detail-meta">
          <text>购买链接</text><button class="small-button" bindtap="copyLink">复制链接</button>
        </view>
        <view wx:if="{{item.feedback.imageId}}" class="detail-meta">
          <text>购买图片</text><button wx:if="{{!photoSrc}}" class="small-button" bindtap="showPhoto">查看图片</button>
        </view>
        <image wx:if="{{photoSrc}}" class="purchase-photo" src="{{photoSrc}}" mode="widthFix" />
        <text
          selectable="{{true}}"
          class="detail-description saved-note"
          wx:if="{{item.feedback.note}}"
          >{{item.feedback.note}}</text
        >
      </view>
      <view wx:if="{{item.state !== 'complete'}}" class="detail-actions">
        <button class="detail-primary" bindtap="openSheet" disabled="{{saving}}" hover-class="row-pressed">
          {{item.state === 'bought' ? '修改购买信息' : '确认下单'}}
        </button>
        <button
          wx:if="{{item.state === 'bought'}}"
          class="detail-secondary"
          bindtap="cancelPurchase" disabled="{{saving}}"
        >
          撤销购买确认
        </button>
      </view>
    </block>
  </view>
  <view wx:if="{{sheet}}" class="sheet-overlay">
    <view class="sheet-backdrop" bindtap="closeSheet" catchtouchmove="stop"></view>
    <view
      class="purchase-sheet {{keyboardHeight ? 'sheet-keyboard' : ''}}"
      aria-role="dialog"
      aria-label="确认购买"
      style="bottom: {{keyboardHeight}}px"
    >
      <text class="sheet-title">{{item.state === 'bought' ? '修改购买信息' : '确认购买'}}</text>
      <text class="sheet-material">{{item.title}}</text>
      <scroll-view
        class="sheet-scroll"
        scroll-y="{{true}}"
        scroll-into-view="{{focusedField}}"
        style="max-height: calc(100vh - {{keyboardHeight}}px - 165px)"
      >
        <view id="brand-field" class="sheet-field">
          <text>产品品牌</text>
          <input
            value="{{draft.brand}}"
            placeholder="请输入品牌"
            maxlength="80"
            aria-label="产品品牌"
            data-field="brand"
            data-scroll-id="brand-field"
            bindinput="writeFeedback"
            bindfocus="focusFeedback"
            bindkeyboardheightchange="keyboardChange"
            adjust-position="{{false}}"
          />
        </view>
        <view id="model-field" class="sheet-field">
          <text>产品型号</text>
          <input
            value="{{draft.model}}"
            placeholder="请输入型号"
            maxlength="80"
            aria-label="产品型号"
            data-field="model"
            data-scroll-id="model-field"
            bindinput="writeFeedback"
            bindfocus="focusFeedback"
            bindkeyboardheightchange="keyboardChange"
            adjust-position="{{false}}"
          />
        </view>
        <view id="link-field" class="sheet-field">
          <text>购买链接 <text class="optional-label">选填</text></text>
          <input value="{{draft.link}}" placeholder="粘贴 HTTPS 商品链接" maxlength="1000"
            aria-label="购买链接" data-field="link" data-scroll-id="link-field"
            bindinput="writeFeedback" bindfocus="focusFeedback"
            bindkeyboardheightchange="keyboardChange" adjust-position="{{false}}" />
        </view>
        <view id="note-field" class="sheet-field">
          <text>购买备注 <text class="optional-label">选填</text></text>
          <textarea
            value="{{draft.note}}"
            placeholder="填写其他购买说明"
            maxlength="1000"
            aria-label="购买备注"
            data-field="note"
            data-scroll-id="note-field"
            bindinput="writeFeedback"
            bindfocus="focusFeedback"
            bindkeyboardheightchange="keyboardChange"
            adjust-position="{{false}}"
          />
        </view>
        <view wx:if="{{verified}}" class="sheet-field">
          <text>购买图片 <text class="optional-label">选填，1 张</text></text>
          <view class="photo-actions">
            <button class="small-button" bindtap="choosePhoto" disabled="{{saving || pickingPhoto}}">{{photoState === 'new' || photoState === 'existing' ? '更换图片' : '选择图片'}}</button>
            <button wx:if="{{photoState === 'new' || photoState === 'existing'}}" class="small-button" bindtap="removePhoto" disabled="{{saving}}">移除</button>
          </view>
        </view>
        <text wx:if="{{draftError}}" class="draft-error" aria-role="alert">{{draftError}}</text>
      </scroll-view>
      <view class="sheet-actions">
        <button class="detail-secondary" bindtap="closeSheet" disabled="{{saving}}">取消</button>
        <button class="detail-primary" bindtap="confirm" disabled="{{saving || pickingPhoto}}" loading="{{saving}}">
          {{item.state === 'bought' ? '保存修改' : '确认下单'}}
        </button>
      </view>
    </view>
  </view>
</view>
