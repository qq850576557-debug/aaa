.login {
  padding: 32px 24px;
  max-width: 480px;
  margin: auto;
}
.brand {
  background: #244e42;
  color: #fff;
  text-align: center;
  border-radius: 20px;
  padding: 28px 20px;
  margin-bottom: 20px;
}
.logo {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  margin-bottom: 14px;
}
.camera-icon {
  width: 28px;
  height: 20px;
  border: 2px solid #eaf0e9;
  border-radius: 5px;
  margin: 20px auto 0;
  position: relative;
}
.camera-icon::before {
  content: '';
  position: absolute;
  width: 8px;
  height: 8px;
  border: 2px solid #eaf0e9;
  border-radius: 50%;
  top: 3px;
  left: 7px;
}
.field {
  background: #f7f8f4;
}
.account-field {
  height: 48px;
  min-height: 48px;
  line-height: 22px;
  padding-top: 13px;
  padding-bottom: 13px;
  overflow: hidden;
}
.panel {
  padding: 22px;
}
.error {
  margin-top: 12px;
}
