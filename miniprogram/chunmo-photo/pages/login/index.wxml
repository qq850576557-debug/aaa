<view class="login"
  ><view class="brand"
    ><image src="/assets/chunmo-original.jpg" mode="aspectFit" class="logo" /><view class="title"
      >春茉工地拍照</view
    ><view class="camera-icon"></view></view
  ><view class="panel"
    ><input
      class="field"
      type="text"
      value="{{login}}"
      bindinput="accountInput"
      placeholder="员工账号"
      maxlength="80"
      confirm-type="next"
      bindconfirm="next"
    /><view wx:if="{{error}}" class="error">{{error}}</view
    ><button class="primary spaced" bindtap="next" loading="{{busy}}" disabled="{{busy}}">
      下一步</button
    ><button class="quiet" bindtap="privacyContract">隐私保护指引</button></view
  ></view
><privacy-dialog show="{{privacyVisible}}" />
