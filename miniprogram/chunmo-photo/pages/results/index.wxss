.results {
  padding: 18px 16px calc(110px + env(safe-area-inset-bottom));
}
.title {
  font-size: 20px;
}
.small {
  font-size: 13px;
  padding: 9px 10px;
}
.summary {
  font-size: 13px;
  color: #617269;
  margin: 14px 0 18px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
  margin-top: 16px;
}
.tile {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: #eaf0e9;
  border: 2px solid transparent;
  min-width: 0;
}
.selected {
  border-color: #244e42;
}
.thumb,
.placeholder {
  width: 100%;
  height: 124px;
  background: #e3e8e0;
}
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #617269;
}
.check {
  position: absolute;
  top: 6px;
  left: 6px;
  width: 21px;
  height: 21px;
  line-height: 21px;
  text-align: center;
  background: #fff;
  border-radius: 50%;
  font-size: 14px;
  color: #244e42;
}
.selected .check {
  background: #244e42;
  color: #fff;
}
.tile-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6px 0 8px;
  font-size: 11px;
  color: #244e42;
  min-height: 40px;
  gap: 2px;
}
.save-one {
  font-size: 19px;
  padding: 4px 10px;
  background: transparent;
  min-width: 36px;
  min-height: 40px;
}
.dimensions {
  font-size: 10px;
  color: #617269;
  padding: 0 8px 8px;
}
.secondary {
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 18px;
  gap: 0;
}
.empty {
  text-align: center;
  padding: 40px 0;
}
.error {
  margin-bottom: 10px;
}
