.edit {
  padding: 20px 20px calc(100px + env(safe-area-inset-bottom));
}
.title {
  margin-bottom: 18px;
}
.label {
  margin: 14px 0 8px;
  color: #617269;
  font-size: 13px;
}
.picker {
  padding-top: 13px;
}
.area {
  box-sizing: border-box;
  width: 100%;
  height: 110px;
  padding: 12px;
  background: white;
  border: 1px solid #e3e8e0;
  border-radius: 10px;
}
.event {
  font-size: 12px;
  color: #617269;
  line-height: 1.6;
  padding: 12px 0;
  border-bottom: 1px solid #e3e8e0;
}

.footer .primary {
  width: 100%;
}
